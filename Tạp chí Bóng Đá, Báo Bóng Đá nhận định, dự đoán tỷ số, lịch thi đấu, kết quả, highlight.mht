.pls-topLeft { text-align: right; vertical-align: bottom; background: inherit !important; }

.pls-topRight { text-align: left; vertical-align: bottom; background: inherit !important; }

.pls-bottomLeft { text-align: right; background: inherit !important; }

.pls-bottomRight { text-align: left; vertical-align: top; background: inherit !important; }

.pls-tailbottom, .pls-tailleft, .pls-tailright, .pls-tailtop { display: none; position: relative; }

.pls-dropBL, .pls-dropBR, .pls-dropTR, .pls-tailbottom, .pls-tailleft, .pls-tailright, .pls-tailtop { background-image: url("//ssl.gstatic.com/s2/oz/images/stars/po/bubblev1/bubbleSprite_3.png") !important; background-repeat: no-repeat; }

.tbl-grey .pls-dropBL, .tbl-grey .pls-dropBR, .tbl-grey .pls-dropTR, .tbl-grey .pls-tailbottom, .tbl-grey .pls-tailleft, .tbl-grey .pls-tailright, .tbl-grey .pls-tailtop { background-image: url("//ssl.gstatic.com/s2/oz/images/stars/po/bubblev1/bubbleSprite-grey.png") !important; }

.pls-tailbottom { background-position: -23px 0px; }

.pls-confirm-container .pls-tailbottom { background-position: -23px -10px; }

.pls-tailtop { background-position: -19px -20px; }

.pls-tailright { background-position: 0px 0px; }

.pls-tailleft { background-position: -10px 0px; }

.pls-tailtop { vertical-align: top; }

.gc-bubbleDefault td { line-height: 0; font-size: 0px; }

.pls-tailbottom, .pls-topLeft img, .pls-topRight img { vertical-align: bottom; }

.bubbleDropTR, .pls-bottomLeft, .pls-bottomLeft img, .pls-dropBottom img, .pls-dropBottomL img, .pls-dropBottomR img { vertical-align: top; }

.pls-dropTR { background-position: 0px -22px; }

.pls-dropBR { background-position: 0px -27px; }

.pls-dropBL { background-position: 0px -16px; }

.pls-spacerbottom, .pls-spacerleft, .pls-spacerright, .pls-spacertop { position: static !important; }

.pls-spinner { inset: 0px; position: absolute; margin: auto; }
