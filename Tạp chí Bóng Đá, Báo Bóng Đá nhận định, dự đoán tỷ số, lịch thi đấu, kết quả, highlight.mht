@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; font-family: Arial, Helvetica, sans-serif; }

body { }

a { cursor: pointer; text-decoration: none; }

.youtube-wrapper { max-width: 1200px; margin: auto; padding: 20px; }

.youtube-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

.video-card { background: white; border-radius: 10px; overflow: hidden; transition: 0.3s; box-shadow: rgba(0, 0, 0, 0.08) 0px 3px 12px; }

.video-card:hover { transform: translateY(-4px); }

.thumbnail-wrapper { position: relative; }

.thumbnail-wrapper img { width: 100%; display: block; }

.play-icon { position: absolute; bottom: 10px; left: 10px; background: red; width: 38px; height: 38px; border-radius: 50%; display: flex; justify-content: center; align-items: center; }

.play-icon::after { content: ""; border-left: 12px solid white; border-top: 7px solid transparent; border-bottom: 7px solid transparent; margin-left: 3px; }

.video-title { font-size: 17px; font-weight: bold; line-height: 1.4; padding: 12px 15px 20px; color: rgb(34, 34, 34); }

.video-title:hover { color: rgb(204, 0, 0); }

@media (max-width: 1024px) {
  .youtube-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .youtube-grid { grid-template-columns: 1fr; }
}
