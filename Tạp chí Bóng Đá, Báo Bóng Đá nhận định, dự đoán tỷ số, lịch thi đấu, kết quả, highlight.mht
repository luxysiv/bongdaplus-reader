.gc-bubbleDefault { text-align: left; background-color: transparent !important; padding: 0px !important; margin: 0px !important; border: 0px !important; table-layout: auto !important; }

.gc-reset { text-align: left; background-color: transparent !important; border: 0px !important; padding: 0px !important; margin: 0px !important; }

.pls-bubbleTop { border-bottom: 1px solid rgb(204, 204, 204) !important; }

