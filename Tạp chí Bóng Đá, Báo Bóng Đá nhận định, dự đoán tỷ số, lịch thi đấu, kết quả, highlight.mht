.pls-topTail { background-repeat: repeat-x !important; background-position: center bottom !important; }

.pls-vertShim { background-color: rgb(255, 255, 255) !important; text-align: right; }

.tbl-grey .pls-vertShim { background-color: rgb(245, 245, 245) !important; }

.pls-vertShimLeft { height: 4px; background-repeat: repeat-y !important; background-position: 100% center !important; }

.pls-vertShimRight { height: 4px; }

.pls-confirm-container .pls-vertShim { background-color: rgb(255, 243, 194) !important; }

.pls-contentWrap { vertical-align: top; background-color: rgb(255, 255, 255) !important; position: relative !important; }

.pls-contentLeft { background-repeat: repeat-y; background-position: 100% center; vertical-align: top; }

