body { display: table; height: 100%; padding: 0px; margin: 0px; }

#yt-subscribe-card { padding: 2px 5px 5px; overflow: hidden; white-space: nowrap; }

.yt-user-icon { float: left; width: 40px; }

.yt-subscription-prompt, .yt-user-name { margin-left: 50px; height: 14px; line-height: 14px; text-align: center; white-space: nowrap; }

.yt-subscription-prompt { margin-top: 6px; color: rgb(85, 85, 85); font-size: 11px; }

.yt-subscription-prompt .channel-name { font-weight: 500; }

.yt-user-name { color: rgb(0, 0, 0); font-weight: 500; font-size: 13px; }

.yt-state { padding: 2px; height: 16px; overflow: hidden; color: rgb(118, 118, 118); white-space: nowrap; }

.yt-subscribe-msg, .yt-unsubscribe-msg { display: block; height: 0px; visibility: hidden; overflow: hidden; white-space: nowrap; overflow-wrap: normal; text-overflow: ellipsis; box-sizing: border-box; }

#yt-subscribe-card.subscribe .yt-subscribe-msg, #yt-subscribe-card.subscribed .yt-unsubscribe-msg { height: auto; visibility: visible; }

.yt-subscribe-msg .yt-user-name, .yt-unsubscribe-msg .yt-user-name { margin-left: 0px; }
